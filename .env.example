# AgentMemHub 环境变量示例
#
# 主要配置走 agentmemhub.yaml（见 agentmemhub.yaml.example）；
# 环境变量用于临时覆盖或 CI/测试隔离。通过 os.environ 读取，不强制使用 .env 文件。
#
# 路径约定：默认值由代码在运行时推导（项目内 database/、models/），
#          无需在此填写真实绝对路径 / 用户名 / token。

# ---- 数据目录与采集库 ----
# AGENTMEM_HUB_DATA_DIR=<项目根>/database            # 覆盖数据根目录（db/水位/评分状态）
# AGENTMEMHUB_DB=<项目根>/database/agentmemhub.db   # 单独覆盖采集库路径

# ---- 记忆后端（v2.0）----
# AGENTMEMHUB_BACKEND=rag                           # rag（内置引擎，默认）| memos（回退）

# ---- 各 Agent 数据目录覆盖（默认自动发现）----
# ZCODE_HOME=<USER_HOME>/.zcode
# OPENCODE_HOME=<USER_HOME>/.local/share/opencode
# WORKBUDDY_HOME=<USER_HOME>/.workbuddy

# ---- 回退模式（仅在 AGENTMEMHUB_BACKEND=memos 时需要）----
# MEMOS_BASE_URL=http://127.0.0.1:18800
# MEMOS_PASSWORD=

# ---- LLM（记忆蒸馏 / 自动评分；三项齐全相关功能才可用）----
# 也可直接写在 agentmemhub.yaml 的 llm 段（推荐；本地 yaml 已 gitignore）。
# AGENTMEMHUB_LLM_ENDPOINT=https://api.deepseek.com/chat/completions
# AGENTMEMHUB_LLM_API_KEY=
# AGENTMEMHUB_LLM_MODEL=deepseek-v4-flash
# AGENTMEMHUB_LLM_PROXY=                            # 仅当 LLM 必须走代理时设置

# ---- 模型下载（scripts/fetch_model.py）----
# AGENTMEMHUB_DL_PROXY=http://127.0.0.1:7897        # 直连失败时的代理兜底

# 注意：永远不要把真实 token / 用户名 / 私有路径写入仓库。
