# AgentMemHub 环境变量示例
# 复制为 .env 并按需设置；本项目通过 os.environ 读取，不强制使用 .env 文件。
# 说明：默认路径均由各 adapter 在运行时通过 Path.home() 自动发现，
#       无需在此填写真实绝对路径 / 用户名 / token。

# ---- 数据库位置（默认 ~/.agentmemhub/agentmemhub.db）----
# agentmem_hub_data_dir=<USER_HOME>/.agentmemhub
# AGENTMEMHUB_DB=<USER_HOME>/.agentmemhub/agentmemhub.db

# ---- 各 Agent 数据目录覆盖（默认自动发现）----
# ZCODE_HOME=<USER_HOME>/.zcode
# OPENCODE_HOME=<USER_HOME>/.local/share/opencode
# WORKBUDDY_HOME=<USER_HOME>/.workbuddy

# ---- MemOS 桥接（推送目标，可选）----
# AGENTMEMHUB_MEMOS_URL=http://127.0.0.1:18800

# 注意：永远不要把真实 token / 用户名 / 私有路径写入仓库。
