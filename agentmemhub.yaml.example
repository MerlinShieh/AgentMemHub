# AgentMemHub 配置文件模板
#
# 用法：复制本文件为 agentmemhub.yaml（项目根），按需修改；不复制则全部用
# 官方默认路径，功能与现状一致。
#
# 优先级：环境变量（AGENTMEMHUB_* / MEMOS_*） > 本文件 > 内置默认。
# 相对路径相对项目根；~ 展开为用户目录。所有非必填项留空 = 官方默认。

# ---------------------------------------------------------------------------
# AgentMemHub 自身数据
# ---------------------------------------------------------------------------
# data_dir: 本地数据库 / 水位 / 评分状态 / 托管状态的目录
#           （默认 <项目根>/database，随项目走便于备份与整机迁移）
# db_path:  统一会话库 SQLite 文件（默认 <data_dir>/agentmemhub.db）
data_dir: "database"
db_path: ""

# ---------------------------------------------------------------------------
# 各 Agent Harness 的会话数据位置（默认官方路径，自动发现）
# 需要覆盖时给出目录/文件路径（见 adapters 的 candidate_paths 语义）
# ---------------------------------------------------------------------------
agents:
  # zcode:  "~/.zcode/cli/db/db.sqlite"
  # opencode: "~/.local/share/opencode/opencode.db"
  # hermes: "~/AppData/Local/hermes/state.db"   # Windows 示例（系统盘非 C: 时很有用）
  # qwen:   "~/.qwen"
  # qodercn: "~/.qoder-cn"
  # workbuddy: "~/.workbuddy"
  # dsh:    "~/.dsh"
  zcode: ""
  opencode: ""
  hermes: ""
  qwen: ""
  qodercn: ""
  workbuddy: ""
  dsh: ""

# ---------------------------------------------------------------------------
# Web 看板
# ---------------------------------------------------------------------------
web:
  port: 8086

# ---------------------------------------------------------------------------
# MemOS 记忆引擎（上游，AgentMemHub 只调接口 / 托管进程，不改其源码）
# ---------------------------------------------------------------------------
memos:
  # 引擎地址
  base_url: "http://127.0.0.1:18800"
  # repo_dir: MemOS 项目根（完整 repo，含 apps/memos-local-plugin）。
  #   默认 <项目根>/memOS —— 使用 AgentMemHub 内建目录时无需配置；
  #   想放其他位置（如 D:\tools\MemOS-Local-Plugin）时在此指定。
  repo_dir: ""
  # plugin_dir: MemOS repo 的 apps/memos-local-plugin。
  #   留空 = 从 repo_dir 自动推导（<repo_dir>/apps/memos-local-plugin）。
  plugin_dir: ""
  # home: 引擎 home（记忆库 / .auth.json / config.yaml 所在）。
  #   留空时：MemOS 在项目内 → 默认 <repo_dir>/home；
  #   否则用引擎官方默认位置（Windows hermes: %LOCALAPPDATA%\hermes\memos-plugin）。
  home: ""
  # password: 引擎 viewer 密码（网关遇 401 自动登录用；留空则不尝试登录）
  password: ""
  # lightweight: true=轻量模式（写入记忆不进化）；false=完整进化链；
  #   留空 = 交给引擎自身的 config.yaml 配置（可用 memos-daemon --lightweight 控制）
  lightweight: ""

# ---------------------------------------------------------------------------
# 检索（内置记忆引擎 agentmemhub/rag；backend=rag 时生效）
#   这里只列与**召回质量**直接相关的键，完整参数见 docs/data-architecture.md §4
# ---------------------------------------------------------------------------
rag:
  retrieval:
    # recall_level: 召回严格度档位 1~5（1 最严格 … 5 最宽松，**默认 3「均衡」**）
    #   一条刻度同时决定：候选宽度 / 非页面相对阈值 / 终审阈值 / 页面席位 /
    #   字面兜底席 / 证据门槛线 —— 避免散着配出互相矛盾的组合。
    #   要"更全"调高，要"更干净"调低。实测：档 3 在 5 个已知案例里命中 4 个，
    #   档 4 全部命中（代价是返回条数从 5~10 涨到 6~12）。
    # recall_level: 3
    #
    # callers: **按调用方细分档位**（与 logs.files 覆盖同一模式：
    #   默认走全局 recall_level，配了细分就用细分的；细分配错则回落全局）。
    #
    #   为什么需要它：**用户主动检索**希望"尽量不遗漏"，而 **Agent 的自动召回**
    #   希望"少而准"（每次对话都要注入上下文，太长反而干扰）—— 两者不该共用
    #   一条刻度。
    #
    #   可用名（由代码在各入口标注）：
    #     mcp   —— MCP 记忆工具（Agent 自动召回）
    #     panel —— 面板 / HTTP 查询（用户主动检索）
    #     cli   —— 命令行 search
    #     eval  —— 召回评测（通常要全）
    # callers:
    #   mcp: 3
    #   panel: 4
    #   cli: 4
    #   eval: 5

# ---------------------------------------------------------------------------
# LLM 接入（记忆蒸馏使用；自动评分命令与蒸馏**共用本段**——评分入口已在
# 控制台/面板隐藏、当前不生效，命令保留备查。三项齐全相关功能才可用）
#   换模型/换服务商只改这一处：蒸馏与评分都读这里；
#   蒸馏如需单独覆盖，可另写 distillation.llm（继承本段并合并，见下方蒸馏段）
# ---------------------------------------------------------------------------
llm:
  # OpenAI 兼容的 chat/completions 端点
  #   例：https://api.deepseek.com/chat/completions
  #       https://open.bigmodel.cn/api/paas/v4/chat/completions
  endpoint: ""
  # api_key: 只读不打印；也可用环境变量 AGENTMEMHUB_LLM_API_KEY
  api_key: ""
  model: ""               # 如 deepseek-flash / deepseek-v4.1-flash / glm-5.3-flash
  # thinking: 思考模式开关（DeepSeek 系）。留空 = 不下发该参数，用 provider 默认
  #   （DeepSeek 默认**开启**思考且 effort=high）。
  #   "disabled" = 关闭思维链。归纳 / 整理 / 改写类任务不需要深度推理，而
  #     reasoning token **计入输出计费**——实测一次 45 条记忆的编译里 reasoning
  #     占 completion 的 67%（21483 / 32002），关闭可省一半以上成本。
  #   "enabled"  = 显式开启（等价于 provider 默认）。
  #   注意：思考模式下 `temperature` 不生效（传了不报错但被忽略），关闭后才生效。
  # thinking: "disabled"
  # reasoning_effort: 思考强度 low / medium / high / xhigh / max（仅思考模式生效）
  #   · Command Code 只接受这五档（传 "none" 直接 400）
  #   · DeepSeek 官方只认 low / high / max
  #   ⚠️ 低档**不等于低推理量**：实测 reasoning_effort=low 时思维链仍占输出的 63%。
  #      能真正归零的只有 DeepSeek 官方的 thinking=disabled。
  # reasoning_effort: "low"
  # repair_model: **格式修复模型**。主模型返回了内容、但 JSON 解析失败时，
  #   把**原始输出**交给它转成规范 JSON；留空 = 关闭（退回直接抛错）。
  #   为什么值得配：便宜的主模型偶发输出被截断（```json 围栏本身 extract_json
  #     就能剥，真正修不好的是截断），但那份内容是有价值的——丢弃或退化成
  #     拼接都可惜。而"把已有内容转成指定格式"对强模型是简单任务，
  #     且只在失败时触发，成本可忽略。
  #   建议填一个 JSON 遵从性好的模型（实测 deepseek 系 12/12 无格式问题）。
  # repair_model: "deepseek/deepseek-v4.1-flash"
  # headers: provider 特定请求头（多数 provider 不需要）。
  #   部分 provider 有硬性要求（自定义 User-Agent 过 WAF、会话标识头等），
  #   按服务商文档填写；也可用 scripts/sync_llm_from_zcode.py 从 ZCode 配置自动同步。
  # headers:
  #   User-Agent: "AgentMemHub/1.0"

# ---------------------------------------------------------------------------
# 离线批处理（Batch API）：批量推理的**独立配置**（不继承顶层 llm）
#
# 为什么独立成段：批量是**另一套端点与凭据** —— 实测小米 MiMo 的批量主机与
# 实时路由不是一套 key，模型名写法也不同（批量要小写、不带厂商前缀）。
# 让它们互相继承，出问题时无从判断用的是哪一套。
#
# 实测要点（2026-09-29 真凭据探测，详见 docs/modules/batch-offline.md）：
#   · endpoint 的 region 段是 `-cn`（写成 `batch-apicn.…` 会 DNS 解析失败）
#   · `completion_window` 支持到 **336h（14 天）**；官方文档那句"当前固定 24h"是错的
#   · 建任务成功码是 **HTTP 201**、初始状态 `created`（文档未列）；取消是**异步**的
#   · 文件与结果**只保留 30 天**；不支持任务内重试/续跑；不支持流式
# 设计与决策见 docs/batch-offline-plan.md。
# ---------------------------------------------------------------------------
llm_batch:
  endpoint: "https://batch-api-cn.xiaomimimo.com/v1"
  api_key: ""                  # 小米开放平台 API Key（sk-…）；需**实名认证 + 现金余额**
                               # （Token Plan 额度不抵扣批量）。留空 = 未启用离线通道
  model: "mimo-v2.6-flash"     # 批量仅支持 mimo-v2.6-pro / mimo-v2.6-flash
  completion_window: "24h"     # 实测可到 336h；资源紧张时调大
  timeout: 60                  # 单次 HTTP 超时（秒）
  max_retries: 3               # 只作用于幂等动作（建任务绝不自动重试，见客户端说明）

# ---------------------------------------------------------------------------
# LLM Wiki 编译：零散记忆 → 可读页面
#   第一级 scripts/wiki_compile.py   逐会话编译（碎片 → 会话内页面）
#   第二级 scripts/wiki_aggregate.py 跨会话聚合（会话内页面 → 主题实体页）
#
# **两级各自相对顶层 `llm` 覆盖，不是级联继承。** 级联会让第一级换 provider
# 时连带改掉第二级（实测踩过：第一级切到 DeepSeek 官方关推理，第二级因此
# 丢掉了 Command Code 的凭据）。所以 `wiki.l2.llm` 的继承链是
# 顶层 llm → wiki.l2.llm，刻意跳过 wiki.llm。
#
# 为什么两级要分开配：推理需求相反——第一级是"把已经想清楚的结论归纳成页面"，
# 第二级是"把已有页面合并去重"，都不需要长时间思考，而 reasoning token
# **计入输出计费**（实测第一级思维链占其输出的 66%）。
# ---------------------------------------------------------------------------
wiki:
  # enabled: ⚠️ **目前是假开关**（2026-09-29 复核仍如此 —— 缺陷 D-2）：唯一消费点
  #   `wiki_triggers._configured()` 只被 `status()` 调用，`_targets()` 并不检查它
  #   ⇒ 置 false **拦不住**自动触发链。要停自动触发请改用 `wiki.update.enabled: false`
  #   （手动补跑需加 `--force`）。处置方案见 docs/batch-offline-plan.md §18 D-2
  enabled: true
  # Obsidian CLI 可执行文件（**产物链接验收**用，见 `agentmemhub/obsidian.py`）。
  #   为什么要有这个配置位：进程环境是**启动时捕获**的 —— 实测把 Obsidian 目录
  #   加进用户 PATH 后重启，35 条用户 PATH 里 34 条都继承了、**只有最后加的那条没**，
  #   验收于是静默退化成"未验收"。配置位与进程启动时机无关，是唯一稳的做法。
  #   留空则按 `OBSIDIAN_CLI` 环境变量 → PATH 解析。
  #   前置：Obsidian 正在运行 + 设置→通用 已开启「命令行界面」（安装器 1.12.7+）。
  # obsidian_cli: "D:\\tools\\Obsidian\\Obsidian.com"
  # ---- 第一级：逐会话编译 ----
  llm:
    # 留空字段继承顶层 llm。**timeout 默认已是 900s** —— 第一级是长调用（一个
    # 会话几十条记忆，分组与逐组编译的输入可达几万字符），默认 60s 实测会连续
    # 读超时，整会话编译失败。要调小请确认单会话记忆量。
    # 只写需要覆盖的字段，例：
    # endpoint: "https://api.deepseek.com/chat/completions"
    # model: "deepseek-flash"
    # thinking: "disabled"          # DeepSeek 官方：彻底关闭推理（最省）
    # reasoning_effort: "low"       # 只能调强度的 provider（Command Code 等）
  single_shot_max: 12               # 记忆数 ≤ 此值时单次编译（省一次分组调用）
  plan_batch_max: 40                # 分组调用的单批记忆数上限（超出即分批分组）。
                                    # 分组是"输出规模随输入线性增长"的调用 ——
                                    # 101 条一次性分组实测会卡死（60s × 3 次超时；
                                    # 放宽到 900s 后 22 分钟仍无任何响应）。
  page_workers: 3                   # 组级并发度：各组之间**无依赖**，串行纯属浪费
                                    # （实测 32 组串行约 48 分钟 → 并发 3 约 12 分钟）。
                                    # 真实并发 = workers × page_workers；撞 429 会走
                                    # 全局限流闸门统一退避（见 agentmemhub/llm.py），
                                    # 避免多个 worker "各自退避、同时恢复、再次撞限"
  workers: 4                        # 会话级并发（同时编几个会话）。**真实并发 =
                                    #   本值 × page_workers**，两者相乘；上调前先确认
                                    #   上游 RPM/TPM 够用（撞 429 会走全局限流闸门退避）
  # ---- 第二级：跨会话聚合 ----
  l2:
    llm:
      # 同样留空即继承顶层 llm。聚合是"合并已有结论"，通常只调低强度：
      # reasoning_effort: "low"
      # timeout: 900                # 默认 60s 对"输入几万字符"的归域调用必然读超时
    # 以下三个键在 2026-09-22 前**只存在于配置里、脚本从不读取**（argparse 的
    # 默认值恰好等于这里的值，所以"配了不生效"永远不报错）。现已收口：
    # 命令行显式传值 > 本配置 > 脚本常量。
    workers: 6
    min_pages: 2                    # 一个分组少于这么多页就不值得合并成新页
    domain_max: 60                  # 主题域数量上限（控制归域调用的输出规模）
    plan_batch_max: 40              # 域内细分**单批成员上限**（超出即分批调用再合并，
                                    # 批内编号会映射回全局编号）。
                                    # 必须分批的理由与第一级的 plan_batch_max 同理：
                                    # 细分是"输出规模随输入线性增长"的调用，而它
                                    # **失败的兜底代价极大** —— 实测 2026-09-25 一个
                                    # 114 成员的域必撞上游 HTTP 524，当时会把整域压成
                                    # 一页（43 页 → 1 页，两次丢页事故的直接放大器）。
  # ---- 离线批处理：收割节流 + 离线触发器 ----
  batch:
    # ① 收割节流：离线批次提交后要等厂商（实测 18 分钟 ~ 24 小时）。这里**不做定时
    #    循环**，而是让已有的触发点（MCP 启动 / 写入记忆 / 蒸馏收尾 / CLI 动作）顺手
    #    收割一次 —— 队列空时零成本立即返回，所以对实时更新毫无影响。
    check_interval_s: 300           # 距上次检查不足这么多秒就不再查厂商（0=不节流）。
                                    # ⚠️ 阈值只**省流**，并发唯一性另由跨进程锁保证，
                                    # 两者都要（见 docs/modules/batch-offline.md）
    # ② 离线触发器（与上面的 `update` 段**并列**；判定顺序：**离线优先 → 实时兜底**）
    #    两个都开 = 离线优先、实时兜底；只开一个 = 纯某通道；都不开 = 全手动。
    #    为什么并列一整套规则：实时要**及时**，离线要**攒批** —— 划算形状不同。
    enabled: false                  # 默认关：离线要花钱且异步，不默认自动发起
    schedule: ["02:00"]             # 时点档少而集中（夜里跑，白天不打扰）
    dirty_memories: 30              # 阈值调高（实时是 10）：少跑多编译才划算
    first_write_daily: false        # 不追求及时，不必"当日首次写入"就触发

  # ---- 全量重跑（`wiki --action full-run`）----
  # 重新归域 + 全部域重编 + 覆盖写盘（清掉多余域目录，域编号会重排）。
  # 什么时候用：增量归类"撑不住"了（align/hint 提示"『待整理』域已有 N 页"）——
  # 该重新归纳的是**域结构本身**。动手前会自动留快照。
  # ⚠️ 成本：编译段约 300+ 条请求 —— 所以"走哪条通道"很值得选。
  full:
    # realtime=当场出结果（单价高）| offline=官方批量 5 折（等 18 分钟~24 小时）
    # ⚠️ 哪个更划算**取决于凭据**：某些**订阅套餐**给的实时额度折算下来比批量更便宜，
    #    所以这里只做开关、不替你做判断。临时覆盖：`full-run --offline`。
    mode: realtime

# ---------------------------------------------------------------------------
# 记忆蒸馏：原始会话 → 结构化记忆（详见 docs/memory-distillation.md）
# 全部键均可省略（用内置默认）；此处列出便于按需调整
# ---------------------------------------------------------------------------
distillation:
  enabled: true
  # prompt_ver: 提示词版本。**留空 = 跟随代码里的提示词版本**（推荐）——
  #   提示词一改就自动触发重蒸，并作废旧版本产物，不会新旧混杂。
  #   显式给整数则覆盖之（强制重蒸手段，如排查问题时）。
  # prompt_ver: 1
  # llm: 留空字段继承上面的 llm 段；需要蒸馏走更便宜的模型时在此单独覆盖
  # llm:
  #   model: ""
  slice:
    max_chars: 24000       # 单片字符预算（防超上下文；超预算按轮边界切片）
    max_turns: 16          # 单片轮数预算（与字符预算谁先触顶按谁切）
    topic_boundary: true   # 用关键词重叠度细化话题边界，避免把话题从中间切开
    boundary_window: 4     # 粗切点 ±N 轮内寻找最低重叠处作为真边界
    per_message_cap: 2000  # 单条消息送入提示词时的截断字符数
  merge:
    enabled: true          # 同会话多片 → 再过一遍 LLM 合并沉淀（单片会话自动跳过）
  dedup:
    cosine_duplicate: 0.92 # 与既有记忆相似度 ≥ 此值判为重复（丢弃 + 指向已有）
    cosine_similar: 0.80   # ≥ 此值判为相似（入库 + 打标互链）
  sanitize:
    enabled: true          # 入库前正则脱敏兜底（凭据 / 个人信息）
  runtime:
    max_concurrent: 4      # LLM 并发数
    timeout: 60            # 单次调用超时（秒）
    dry_run: false         # true = 只蒸馏不入库（预览成本与产物）

# ---------------------------------------------------------------------------
# 快照与回滚：索引库整库 + wiki 产物目录（详见 docs/data-architecture.md §10）
#   快照对象是**不可重建的 LLM 产物**（wiki 页面重编会漂移、unit_values 的反馈
#   演化值完全无法重建），所以它是最后一道后悔药。增量更新前自动创建，
#   restore 前也会自动给当前状态保护一份。
# ---------------------------------------------------------------------------
snapshot:
  keep: 5                  # 最多保留几份，超出自动删最旧。
                           # 一份约 190 MB（索引库 + 两级 wiki 产物），默认 5 份约 1 GB；
                           # 磁盘紧就调小（≥1），想留更长历史就调大。非法值回退默认。

# ---------------------------------------------------------------------------
# 通知（详见 docs/modules/batch-offline.md）
#   **落库始终启用**（面板可查、带未读状态）；下面是可选的**推送通道**。
#   推送是**旁路**：失败只落 `logs/notify.log` 与 `logs/notify_fallback.jsonl`，
#   绝不影响落库与调用方。
# ---------------------------------------------------------------------------
notify:
  # Pushplus（微信推送，https://www.pushplus.plus）：扫码登录后在"一对一推送"页
  # 复制 token 填进来即可。适合离线批次那种"等几小时到一天、跑完了要知道"的场景。
  pushplus:
    enabled: false         # 默认关：推送是"对外发消息"，不该默认发生
    token: ""              # 你的 Pushplus token（只写本地 yaml，别入库/入仓库）
    topic: ""              # 群组编码（可选；留空 = 自己收）
    timeout: 5             # 单次推送超时（秒）—— 短超时，别拖慢调用方
  dedup_window_s: 300      # 同一 (category, title) 在这个窗口内只留一条。
                           # ⚠️ 它防的是**刷屏**：失败重试与重复触发都会发通知，
                           # 而 Pushplus 是推微信 —— 刷屏的代价远大于"少一条"。0=不去重

  # ---- 推送策略：哪些事件值得**推到微信**（落库不受影响，始终全留）----
  # 两类开关是 **OR**（任一命中即推）—— "只看警告以上"与"wiki 动作我都要知道"
  # 可以并存，不必去枚举"等级 × 类别"的组合。
  #   · 按**类别**：memory_write（记忆写入）/ wiki_trigger（wiki 更新相关：
  #     category ∈ wiki / batch / trigger，含离线批次提交、落盘、过期预警）
  #   · 按**等级**：info（一般消息）/ warning（紧急或警告）/ error（严重错误）
  push_when:
    memory_write: false    # ① 记忆写入（默认关：发的是**本轮汇总**，不是每条）
    wiki_trigger: true     # ② 触发 Wiki 更新（含离线批次提交 / 落盘 / 过期预警）
    info: false            # ③ 一般消息通知
    warning: true          # ④ 紧急或警告通知
    error: true            # ⑤ 严重错误通知

# ---------------------------------------------------------------------------
# 日志滚动与归档（详见 docs/data-architecture.md §11「日志体系」）
#   **作用域**：`rotate` 是全局默认，对**所有**日志生效；`files.<日志名>`
#   覆盖它——单文件那段为空（或没写）时自动回落全局。
#   **滚动规则二选一**（不会同时命中）：
#     · `max_mb` > 0  → 按**大小**滚动（**最高优先级**）
#     · 否则 `daily` 为真 → 按**自然日首次写入**滚动（靠文件 mtime 判定）
#     · 两者都不配 → 不滚动
#   归档位置：`logs/archive/<日志名>/<日志名>.<毫秒时间戳>`（先按日志名分文件夹）
#   `compress: false` 时保留**原始文件数据**；置 true 则 gzip。
#   时间维度最低单位是**一个自然日（24 小时）**。
# ---------------------------------------------------------------------------
logs:
  rotate:
    max_mb: 5              # 超过多少 MB 滚动（0 = 不启用大小规则）
    daily: false           # 按自然日首次写入滚动（有大小规则时本项被忽略）
    keep_days: 30          # 归档保留天数，超出删最旧（0 = 不限）
    compress: false        # 归档是否 gzip（当前保留原始文件）
    archive_dir: archive   # 归档根目录（相对 logs/）
  files: {}                # 单文件覆盖（空 = 全部走全局），例：
                           #   wiki:  {max_mb: 20}
                           #   tasks: {daily: true, keep_days: 7}
